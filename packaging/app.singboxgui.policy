<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Singbox GUI</vendor>
  <vendor_url>https://github.com/alirezajokar/singbox-gui</vendor_url>

  <action id="app.singboxgui.helper">
    <description>Manage the sing-box service and its configuration</description>
    <description xml:lang="fa">مدیریت سرویس sing-box و کانفیگ آن</description>
    <message>Authentication is required to manage the sing-box service</message>
    <message xml:lang="fa">برای مدیریت سرویس sing-box به رمز عبور نیاز است</message>
    <icon_name>singbox-gui</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/singbox-gui/helper</annotate>
  </action>
</policyconfig>
